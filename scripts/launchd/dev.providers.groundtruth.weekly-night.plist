<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  groundtruth's weekly Monday night (docs/weekly-night.md). A template: scripts/install-weekly-night.sh fills the
  __PLACEHOLDERS__ in and installs it, with the owner's OK only. launchd reads StartCalendarInterval in the Mac's own
  time zone (Europe/Bucharest on the owner's Mac; the night checks its time in Europe/Bucharest itself). A job missed
  while the Mac slept runs when it wakes; the night itself refuses to start after 03:00 on the Tuesday, and asks.
  The wake is the owner's: sudo pmset repeat wakeorpoweron M 22:55:00
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.providers.groundtruth.weekly-night</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-B</string>
    <string>harness/weekly.py</string>
    <string>__MODE__</string>
    <string>night</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GROUNDTRUTH_CLIENT_HOME</key>
    <string>__CLIENT_HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__CLIENT_HOME__/weekly-night.log</string>
  <key>StandardErrorPath</key>
  <string>__CLIENT_HOME__/weekly-night.log</string>
</dict>
</plist>
